# Copie este archivo como .env (no lo suba al repositorio) o defina las
# variables en el panel del proveedor de hosting (Render).
PORT=3000
NODE_ENV=development

# Opcion 1: cadena de conexion (TiDB Cloud, Railway, Docker)
# DATABASE_URL=mysql://usuario:clave@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/siga_db
# Con TiDB Cloud el cifrado TLS se activa solo; en otros servidores use DB_SSL=true si lo exigen.

# Opcion 2: MySQL local (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siga_db

# Seguridad: clave larga y aleatoria para firmar los tokens JWT
JWT_SECRET=cambie-esta-clave
JWT_EXPIRA=2h

# Crear tablas al iniciar y cargar los datos de demostracion si la base esta vacia
AUTO_MIGRATE=true
SEED_DEMO=true
# Clave de los usuarios de demostracion en servidores publicos (si no se define: Siga2026*)
# DEMO_PASSWORD=

# Correo para enviar las facturas (opcional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=facturacion@agroservices.com
# SMTP_PASS=contrasena-de-aplicacion
# SMTP_FROM="AGROSERVICES <facturacion@agroservices.com>"
